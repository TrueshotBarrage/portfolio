---
/**
 * EN · 한국어 switch, plus a one-time suggestion banner for Korean browsers
 * on English pages. Choices are remembered in localStorage and honored by
 * the head script in BaseLayout.
 */
import { getContent, LANG_PREF_KEY, LANG_BANNER_DISMISSED_KEY, type Lang } from "../i18n";

interface Props {
  lang: Lang;
  otherPath: string;
}

const { lang, otherPath } = Astro.props;
const t = getContent(lang).layout;
const labels: Record<Lang, string> = { en: "EN", ko: "한국어" };
const ko = getContent("ko").layout;
---

<nav class="lang-toggle" aria-label={t.languageLabel}>
  {
    (["en", "ko"] as const).map((l) =>
      l === lang ? (
        <span aria-current="true" lang={l}>{labels[l]}</span>
      ) : (
        <a href={otherPath} hreflang={l} lang={l} data-set-lang={l}>
          {labels[l]}
        </a>
      ),
    )
  }
</nav>

{
  lang === "en" && (
    <div id="lang-banner" class="lang-banner" lang="ko" hidden>
      <span>한국어로 보시겠어요?</span>
      <a href={otherPath} data-set-lang="ko">
        한국어로 보기
      </a>
      <button type="button" id="lang-banner-close" aria-label={ko.close}>
        &times;
      </button>
    </div>
  )
}

<script define:vars={{ prefKey: LANG_PREF_KEY, dismissedKey: LANG_BANNER_DISMISSED_KEY }} is:inline>
  // Language choice is a per-browser convenience, so storage failures are ignored
  function read(key) {
    try {
      return localStorage.getItem(key);
    } catch {
      return null;
    }
  }

  function write(key, value) {
    try {
      localStorage.setItem(key, value);
    } catch {}
  }

  document.querySelectorAll("[data-set-lang]").forEach((link) =>
    link.addEventListener("click", () => {
      write(prefKey, link.dataset.setLang);
      // Keep the selected piano tab etc. when switching
      link.href = link.getAttribute("href") + location.hash;
    }),
  );

  const banner = document.getElementById("lang-banner");
  // Only when Korean ranks above English, so bilingual "en, ko" browsers aren't nagged
  const firstMatch = (navigator.languages || [navigator.language]).find((l) =>
    /^(en|ko)\b/i.test(l),
  );
  const prefersKorean = firstMatch?.toLowerCase().startsWith("ko") ?? false;
  if (banner && prefersKorean && !read(prefKey) && !read(dismissedKey)) {
    banner.hidden = false;
  }

  document.getElementById("lang-banner-close")?.addEventListener("click", () => {
    write(dismissedKey, "true");
    if (banner) banner.hidden = true;
  });
</script>

<style>
  .lang-toggle {
    position: absolute;
    top: 1.25rem;
    right: 1.5rem;
    display: flex;
    gap: 0.6rem;
    font-size: 0.8rem;
    z-index: 10;
  }

  .lang-toggle span {
    color: var(--text-primary);
  }

  .lang-toggle a {
    color: var(--text-secondary);
  }

  .lang-toggle a:hover {
    color: var(--text-primary);
    opacity: 1;
  }

  .lang-banner {
    position: fixed;
    bottom: 1.25rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.6rem 0.75rem 0.6rem 1.1rem;
    font-size: 0.85rem;
    white-space: nowrap;
    background: var(--bg-secondary);
    border: 1px solid rgba(122, 162, 247, 0.3);
    border-radius: 999px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
    z-index: 100;
  }

  .lang-banner[hidden] {
    display: none;
  }

  .lang-banner button {
    background: none;
    border: none;
    color: var(--text-secondary);
    font-size: 1.2rem;
    line-height: 1;
    cursor: pointer;
  }

  .lang-banner button:hover {
    color: var(--text-primary);
  }
</style>
