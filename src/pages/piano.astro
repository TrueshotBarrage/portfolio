---
import BaseLayout from "../layouts/BaseLayout.astro";

interface MonthRange {
  start: number;
  end: number;
  openEnded?: boolean;
}

// Month 1 of the roadmap is Oct 2026
const ROADMAP_START = { year: 2026, month: 9 };

const monthFormatter = new Intl.DateTimeFormat("en-US", {
  month: "short",
  year: "numeric",
  timeZone: "UTC",
});

function roadmapMonth(n: number): string {
  return monthFormatter.format(
    new Date(Date.UTC(ROADMAP_START.year, ROADMAP_START.month + n - 1)),
  );
}

function formatMonths({ start, end, openEnded }: MonthRange): string {
  const plus = openEnded ? "+" : "";
  return `${roadmapMonth(start)} – ${roadmapMonth(end)}${plus} · Months ${start} – ${end}${plus}`;
}

interface RoutineBlock {
  time: string;
  minutes: number;
  focus: string;
  objective: string;
}

interface Milestone {
  composer: string;
  piece: string;
  months: MonthRange;
  intent: string;
  sheetId?: string;
}

interface CzernyPhase {
  name: string;
  months: MonthRange;
  schedule: { days: string; exercise: string }[];
  targets: { exercise: string; label: string; detail: string }[];
}

interface Sheet {
  id: string;
  tab: string;
  title: string;
  subtitle: string;
  pdf: string;
  tempo?: string;
  focus?: string;
  hasWorkbook: boolean;
}

// Content adapted from the Advanced Piano Progression Roadmap PDF
const routine: RoutineBlock[] = [
  {
    time: "0:00",
    minutes: 10,
    focus: "Technical Warm-Up",
    objective:
      "One Czerny exercise or a scale variant. Skeletal alignment, loose wrists, micro-velocity adjustments.",
  },
  {
    time: "0:10",
    minutes: 25,
    focus: "The Hard Work Zone",
    objective:
      "Problem measures in the current milestone piece. Slow reps with a metronome, hands isolated.",
  },
  {
    time: "0:35",
    minutes: 15,
    focus: "Structural Maintenance",
    objective:
      "Review memorized sections of repertoire to consolidate memory and keep endurance up.",
  },
  {
    time: "0:50",
    minutes: 10,
    focus: "Musical Cool-Down",
    objective:
      "Chord-voicing experiments, sight-reading something unfamiliar, or just playing.",
  },
];

const milestones: Milestone[] = [
  {
    composer: "Chopin",
    piece: "Nocturne in C-sharp Minor, Op. posth.",
    months: { start: 1, end: 8 },
    intent:
      "Re-establishing soft classical dynamics, asymmetrical polyrhythmic runs (35 notes over a steady pulse), and lyrical cantabile lines.",
    sheetId: "nocturne",
  },
  {
    composer: "Rachmaninoff",
    piece: "Prelude in C-sharp Minor, Op. 3 No. 2",
    months: { start: 9, end: 18 },
    intent:
      "Deep arm weight, rapid interlocking triplets, four-stave reading, and multi-octave control.",
  },
  {
    composer: "Chopin",
    piece: "Étude Op. 10 No. 3 (“Tristesse”)",
    months: { start: 19, end: 32 },
    intent:
      "Layer separation: projecting the melody with fingers 4 and 5 while the inner fingers keep quiet legatissimo harmonies.",
  },
  {
    composer: "Tchaikovsky (arr. Pletnev)",
    piece: "Pas de Deux from The Nutcracker",
    months: { start: 33, end: 55, openEnded: true },
    intent:
      "The pinnacle. Rapid parallel interval cascades, wide-register arpeggios, and grand orchestral sonority.",
  },
];

const czernyPhases: CzernyPhase[] = [
  {
    name: "Phase 1 · Precision & Arpeggios",
    months: { start: 1, end: 3 },
    schedule: [
      { days: "Mon / Wed / Fri", exercise: "No. 1" },
      { days: "Tue / Thu / Sat", exercise: "No. 11" },
    ],
    targets: [
      {
        exercise: "No. 1",
        label: "Finger action & articulation",
        detail: "Sharp knuckle strokes with a completely still hand.",
      },
      {
        exercise: "No. 11",
        label: "Finger change & smooth arpeggios",
        detail: "Seamless horizontal gliding and invisible thumb tucks.",
      },
    ],
  },
  {
    name: "Phase 2 · Left Hand & Double Notes",
    months: { start: 4, end: 6 },
    schedule: [
      { days: "Mon / Wed / Fri", exercise: "No. 12" },
      { days: "Tue / Thu / Sat", exercise: "No. 39" },
    ],
    targets: [
      {
        exercise: "No. 12",
        label: "Left-hand flexibility",
        detail: "Bring left-hand agility up to match the right.",
      },
      {
        exercise: "No. 39",
        label: "Exercise in thirds",
        detail: "Synchronized double notes, groundwork for Chopin's parallel 6ths.",
      },
    ],
  },
];

// Tempo markings follow the Edition Peters score
const sheets: Sheet[] = [
  {
    id: "no-1",
    tab: "No. 1",
    title: "Czerny Op. 740, No. 1",
    subtitle: "Action of the fingers, the hand quiet",
    pdf: "/piano/czerny-740-no-01.pdf",
    tempo: "Molto allegro · half note = 92",
    focus:
      "Isolate finger action from the knuckles. No sympathetic tension in the non-playing fingers. Keep the palm steady and silent.",
    hasWorkbook: true,
  },
  {
    id: "no-11",
    tab: "No. 11",
    title: "Czerny Op. 740, No. 11",
    subtitle: "Readiness in changing the fingers",
    pdf: "/piano/czerny-740-no-11.pdf",
    tempo: "Molto allegro · half note = 88",
    focus:
      "Smooth lateral hand transitions over shifting keys. Prepare each finger configuration before you need it.",
    hasWorkbook: true,
  },
  {
    id: "no-12",
    tab: "No. 12",
    title: "Czerny Op. 740, No. 12",
    subtitle: "Flexibility of the left hand",
    pdf: "/piano/czerny-740-no-12.pdf",
    tempo: "Vivace · quarter note = 76",
    focus:
      "Equalize velocity between the hands. No left-hand lag in the continuous bass-clef runs.",
    hasWorkbook: true,
  },
  {
    id: "no-39",
    tab: "No. 39",
    title: "Czerny Op. 740, No. 39",
    subtitle: "Exercise in thirds",
    pdf: "/piano/czerny-740-no-39.pdf",
    tempo: "Allegro vivace · dotted half note = 66",
    focus:
      "Perfect vertical alignment of each pair. Downstrokes and releases land together. (Starts partway down the first page.)",
    hasWorkbook: true,
  },
  {
    id: "nocturne",
    tab: "Nocturne",
    title: "Chopin: Nocturne in C-sharp Minor",
    subtitle: "Op. posth. (1830)",
    pdf: "/piano/chopin-nocturne-c-sharp-minor.pdf",
    tempo: "Lento con gran espressione",
    hasWorkbook: false,
  },
];

const workbook: { group: string; items: string[] }[] = [
  {
    group: "Rhythmic displacement",
    items: ["Dotted rhythms (long-short)", "Reverse-dotted rhythms (short-long)"],
  },
  {
    group: "Articulation",
    items: ["Staccato", "Glassy legato with crisp releases"],
  },
  {
    group: "Velocity",
    items: ["60% tempo", "80% tempo", "100% tempo, zero tension"],
  },
];
---

<BaseLayout title="Piano | David Kim" noindex>
  <main>
    <article class="piano">
      <header>
        <h1>Piano</h1>
        <p class="subtitle">Practice roadmap &amp; sheet music</p>
      </header>

      <section>
        <h2>The daily hour</h2>
        <p class="lead">
          5 hours a week. Each session prioritizes targeted blocks over casual
          playthroughs.
        </p>
        <ol class="routine">
          {
            routine.map((block) => (
              <li class="routine-block" style={`--minutes: ${block.minutes}`}>
                <div class="routine-bar">
                  <span>{block.minutes}m</span>
                </div>
                <div class="routine-text">
                  <span class="routine-time">{block.time}</span>
                  <h3>{block.focus}</h3>
                  <p>{block.objective}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </section>

      <section>
        <h2>Repertoire milestones</h2>
        <ol class="milestones">
          {
            milestones.map((m, i) => (
              <li class="milestone">
                <span class="milestone-index">{i + 1}</span>
                <div>
                  <span class="milestone-months">{formatMonths(m.months)}</span>
                  <h3>
                    <span class="composer">{m.composer}</span> {m.piece}
                  </h3>
                  <p>{m.intent}</p>
                  {m.sheetId && (
                    <a href={`#${m.sheetId}`} class="sheet-jump" data-sheet={m.sheetId}>
                      Sheet music ↓
                    </a>
                  )}
                </div>
              </li>
            ))
          }
        </ol>
      </section>

      <section>
        <h2>Czerny Op. 740 plan</h2>
        <p class="lead">
          Focused interventions for hand mechanics. Once an exercise is clean at
          the target tempo with no forearm tension, retire it.
        </p>
        <div class="phases">
          {
            czernyPhases.map((phase) => (
              <div class="phase">
                <span class="phase-months">{formatMonths(phase.months)}</span>
                <h3>{phase.name}</h3>
                <ul class="phase-schedule">
                  {phase.schedule.map((s) => (
                    <li>
                      <span>{s.days}</span>
                      <strong>{s.exercise}</strong>
                    </li>
                  ))}
                </ul>
                <ul class="phase-targets">
                  {phase.targets.map((t) => (
                    <li>
                      <strong>
                        {t.exercise} · {t.label}
                      </strong>
                      <span>{t.detail}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </section>

      <section id="sheet-music">
        <h2>Sheet music</h2>
        <div class="tabs" role="tablist" aria-label="Sheet music">
          {
            sheets.map((sheet, i) => (
              <button
                type="button"
                role="tab"
                id={`tab-${sheet.id}`}
                aria-controls={`panel-${sheet.id}`}
                aria-selected={i === 0 ? "true" : "false"}
                data-sheet={sheet.id}
              >
                {sheet.tab}
              </button>
            ))
          }
        </div>

        {
          sheets.map((sheet, i) => (
            <div
              class="sheet-panel"
              role="tabpanel"
              id={`panel-${sheet.id}`}
              aria-labelledby={`tab-${sheet.id}`}
              data-sheet={sheet.id}
              hidden={i !== 0}
            >
              <div class="sheet-info">
                <div>
                  <h3>{sheet.title}</h3>
                  <p class="sheet-subtitle">{sheet.subtitle}</p>
                  {sheet.tempo && <p class="sheet-tempo">{sheet.tempo}</p>}
                  {sheet.focus && <p class="sheet-focus">{sheet.focus}</p>}
                </div>

                {sheet.hasWorkbook && (
                  <div class="workbook">
                    <div class="workbook-header">
                      <span>Mastery checklist</span>
                      <button type="button" class="workbook-reset" data-sheet={sheet.id}>
                        Reset
                      </button>
                    </div>
                    {workbook.map((g) => (
                      <fieldset>
                        <legend>{g.group}</legend>
                        {g.items.map((item) => (
                          <label>
                            <input
                              type="checkbox"
                              data-key={`${sheet.id}:${g.group}:${item}`}
                            />
                            <span>{item}</span>
                          </label>
                        ))}
                      </fieldset>
                    ))}
                  </div>
                )}
              </div>

              <iframe
                class="pdf-frame"
                title={`${sheet.title} sheet music`}
                data-src={`${sheet.pdf}#view=FitH`}
                src={i === 0 ? `${sheet.pdf}#view=FitH` : undefined}
              />

              <div class="pdf-actions">
                <a href={sheet.pdf} target="_blank" rel="noopener" class="pdf-open">
                  Open PDF ↗
                </a>
                <a href={sheet.pdf} download>
                  Download
                </a>
              </div>
            </div>
          ))
        }
      </section>

      <nav class="back-link">
        <a href="/piano/piano-roadmap.pdf" target="_blank" rel="noopener">
          Original roadmap (PDF)
        </a>
        <a href="/">← Back to home</a>
      </nav>
    </article>
  </main>
</BaseLayout>

<script>
  const STORAGE_KEY = "piano-workbook";

  const tabs = document.querySelectorAll<HTMLButtonElement>('[role="tab"]');
  const panels = document.querySelectorAll<HTMLElement>(".sheet-panel");
  const checkboxes = document.querySelectorAll<HTMLInputElement>(
    ".workbook input[type=checkbox]",
  );

  function selectSheet(id: string, updateHash = true) {
    const panel = document.getElementById(`panel-${id}`);
    if (!panel) return;

    tabs.forEach((tab) =>
      tab.setAttribute("aria-selected", String(tab.dataset.sheet === id)),
    );
    panels.forEach((p) => (p.hidden = p !== panel));

    // Load PDFs only when their tab is first opened
    const frame = panel.querySelector<HTMLIFrameElement>(".pdf-frame");
    if (frame && !frame.getAttribute("src") && frame.dataset.src) {
      frame.src = frame.dataset.src;
    }

    if (updateHash) history.replaceState(null, "", `#${id}`);
  }

  tabs.forEach((tab) =>
    tab.addEventListener("click", () => selectSheet(tab.dataset.sheet!)),
  );

  document.querySelectorAll<HTMLAnchorElement>(".sheet-jump").forEach((link) =>
    link.addEventListener("click", (e) => {
      e.preventDefault();
      selectSheet(link.dataset.sheet!);
      document.getElementById("sheet-music")?.scrollIntoView({ behavior: "smooth" });
    }),
  );

  const initial = location.hash.slice(1);
  if (initial) selectSheet(initial, false);

  // Checklist progress is a per-browser convenience, so storage failures are ignored
  function readProgress(): Record<string, boolean> {
    try {
      return JSON.parse(localStorage.getItem(STORAGE_KEY) ?? "{}");
    } catch {
      return {};
    }
  }

  function writeProgress(progress: Record<string, boolean>) {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(progress));
    } catch {
      // ignore
    }
  }

  const progress = readProgress();
  checkboxes.forEach((box) => {
    box.checked = Boolean(progress[box.dataset.key!]);
    box.addEventListener("change", () => {
      progress[box.dataset.key!] = box.checked;
      writeProgress(progress);
    });
  });

  document.querySelectorAll<HTMLButtonElement>(".workbook-reset").forEach((btn) =>
    btn.addEventListener("click", () => {
      checkboxes.forEach((box) => {
        if (box.dataset.key!.startsWith(`${btn.dataset.sheet}:`)) {
          box.checked = false;
          delete progress[box.dataset.key!];
        }
      });
      writeProgress(progress);
    }),
  );
</script>

<style>
  main {
    padding: 3rem 1.5rem;
    width: 100%;
    max-width: 860px;
  }

  .piano {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  header {
    text-align: center;
  }

  h1 {
    font-size: 2rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .subtitle {
    color: var(--text-secondary);
    font-size: 1.1rem;
  }

  h2 {
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--accent);
    margin-bottom: 0.75rem;
  }

  h3 {
    font-size: 1rem;
    font-weight: 500;
    color: var(--text-primary);
  }

  .lead {
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: 1.25rem;
  }

  /* Daily routine: bar widths are proportional to minutes */
  .routine {
    list-style: none;
    display: flex;
    gap: 0.5rem;
  }

  .routine-block {
    flex: var(--minutes) 1 0;
    min-width: 0;
  }

  .routine-bar {
    height: 2.25rem;
    border-radius: 6px;
    display: flex;
    align-items: center;
    padding: 0 0.6rem;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--bg-primary);
    margin-bottom: 0.75rem;
  }

  .routine-block:nth-child(1) .routine-bar {
    background: var(--terminal-cyan);
  }
  .routine-block:nth-child(2) .routine-bar {
    background: var(--terminal-pink);
  }
  .routine-block:nth-child(3) .routine-bar {
    background: var(--terminal-green);
  }
  .routine-block:nth-child(4) .routine-bar {
    background: var(--terminal-yellow);
  }

  .routine-time {
    font-size: 0.75rem;
    color: var(--text-secondary);
    font-variant-numeric: tabular-nums;
  }

  .routine-text h3 {
    font-size: 0.9rem;
    margin: 0.15rem 0 0.35rem;
  }

  .routine-text p {
    font-size: 0.82rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  /* Milestones */
  .milestones {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0;
    border-left: 1px solid rgba(122, 162, 247, 0.25);
    margin-left: 0.9rem;
  }

  .milestone {
    display: flex;
    gap: 1rem;
    padding: 0 0 1.5rem 0;
    margin-left: -0.9rem;
  }

  .milestone:last-child {
    padding-bottom: 0;
  }

  .milestone-index {
    flex: none;
    width: 1.8rem;
    height: 1.8rem;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-size: 0.8rem;
    font-weight: 500;
    background: var(--bg-primary);
    border: 1px solid var(--accent);
    color: var(--accent);
  }

  .milestone:first-child .milestone-index {
    background: var(--accent);
    color: var(--bg-primary);
  }

  .milestone-months {
    font-size: 0.75rem;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .milestone h3 {
    margin: 0.2rem 0 0.4rem;
    line-height: 1.4;
  }

  .composer {
    color: var(--accent);
  }

  .milestone p {
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--text-secondary);
  }

  .sheet-jump {
    display: inline-block;
    margin-top: 0.5rem;
    font-size: 0.85rem;
  }

  /* Czerny phases */
  .phases {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .phase {
    background: var(--bg-secondary);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 10px;
    padding: 1.25rem;
  }

  .phase-months {
    font-size: 0.75rem;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .phase h3 {
    margin: 0.2rem 0 1rem;
  }

  .phase ul {
    list-style: none;
  }

  .phase-schedule {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding-bottom: 1rem;
    margin-bottom: 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .phase-schedule li {
    display: flex;
    justify-content: space-between;
    font-size: 0.875rem;
    color: var(--text-secondary);
  }

  .phase-schedule strong {
    color: var(--terminal-yellow);
    font-weight: 500;
  }

  .phase-targets {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .phase-targets li {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .phase-targets strong {
    font-weight: 500;
    color: var(--text-primary);
  }

  .phase-targets span {
    color: var(--text-secondary);
  }

  /* Sheet music tabs */
  .tabs {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    margin-bottom: 1.25rem;
  }

  .tabs button {
    font: inherit;
    font-size: 0.875rem;
    padding: 0.45rem 0.9rem;
    border-radius: 6px;
    cursor: pointer;
    color: var(--text-secondary);
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition: all 0.2s ease;
  }

  .tabs button:hover {
    color: var(--text-primary);
  }

  .tabs button[aria-selected="true"] {
    color: var(--text-primary);
    background: rgba(122, 162, 247, 0.15);
    border-color: rgba(122, 162, 247, 0.4);
  }

  .sheet-info {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-bottom: 1.25rem;
  }

  .sheet-panel:not(:has(.workbook)) .sheet-info {
    grid-template-columns: 1fr;
  }

  .sheet-subtitle {
    font-style: italic;
    color: var(--text-secondary);
    margin: 0.2rem 0 0.75rem;
    font-size: 0.9rem;
  }

  .sheet-tempo {
    font-size: 0.875rem;
    color: var(--terminal-yellow);
    margin-bottom: 0.75rem;
  }

  .sheet-focus {
    font-size: 0.875rem;
    line-height: 1.65;
    color: var(--text-secondary);
  }

  .workbook {
    background: var(--bg-secondary);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 10px;
    padding: 1rem 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .workbook-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-secondary);
  }

  .workbook-reset {
    font: inherit;
    font-size: 0.75rem;
    text-transform: none;
    letter-spacing: 0;
    background: none;
    border: none;
    color: var(--text-secondary);
    cursor: pointer;
  }

  .workbook-reset:hover {
    color: var(--terminal-red);
  }

  fieldset {
    border: none;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  legend {
    font-size: 0.8rem;
    color: var(--accent);
    margin-bottom: 0.3rem;
  }

  label {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.85rem;
    cursor: pointer;
  }

  input[type="checkbox"] {
    accent-color: var(--terminal-green);
    width: 0.95rem;
    height: 0.95rem;
  }

  input[type="checkbox"]:checked + span {
    color: var(--text-secondary);
    text-decoration: line-through;
  }

  .pdf-frame {
    display: block;
    width: 100%;
    height: 85vh;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    background: #fff;
  }

  .pdf-actions {
    display: flex;
    gap: 1.25rem;
    margin-top: 0.75rem;
    font-size: 0.875rem;
  }

  .back-link {
    display: flex;
    justify-content: space-between;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    font-size: 0.9rem;
  }

  @media (max-width: 768px) {
    main {
      padding: 2rem 1rem;
    }

    .routine {
      flex-direction: column;
      gap: 1rem;
    }

